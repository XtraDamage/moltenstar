{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    { "source": "/boost", "destination": "https://t.me/boost/MoltenGram", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!update\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
